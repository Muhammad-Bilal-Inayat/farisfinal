rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and is an admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.admin == true || 
         request.auth.token.role == 'master_admin' || 
         request.auth.token.role == 'admin' ||
         request.auth.token.email.matches('.*@farisvip.*'));
    }

    // Vehicles Collection Rules
    match /vehicles/{vehicleId} {
      // Anyone (guests, pilgrims) can read vehicle listings and prices
      allow read: if true;
      
      // Only authorized admin users can create, update, or delete vehicle records
      allow create, update, delete: if isAdmin();
    }

    // Admin Audit Logs Collection Rules
    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
